# Sponsor wallet private key with native gas (e.g., Base Sepolia ETH)
# WARNING: Never commit real private keys to git. Keep your .env file secret.
SPONSOR_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE_

# (Optional) Referrer code or inviter username (e.g., referral_code or 0x...)
REFERRAL_CODE=referral_code

# (Optional) Custom RPC endpoint
RPC_URL=https://sepolia.base.org
